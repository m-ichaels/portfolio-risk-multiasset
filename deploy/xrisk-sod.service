[Unit]
Description=xrisk start of day: marks, exposures, limits, VaR, notice dates and settlements due, after the order stack's SOD
After=network-online.target xops-sod.service

[Service]
Type=oneshot
User=xops
WorkingDirectory=/opt/xrisk
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/xrisk/.venv/bin/python -m xrisk sod --date today
StandardOutput=append:/var/log/xrisk/sod.log
StandardError=append:/var/log/xrisk/sod.log
